    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( <http://archaeonatural.cloud/ExternalIdentifier_Geonames> <http://archaeonatural.cloud/ExternalIdentifier_Wikidata> ) ] .

