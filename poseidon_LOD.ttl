@prefix arno: <http://archaeonatural.cloud/ont/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix edtfo: <http://periodo.github.io/edtf-ontology/edtfo.ttl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix lado: <http://archaeology.link/ontology#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix orcid: <http://orcid.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pleiades: <http://pleiades.stoa.org/places/vocab#> .
@prefix poseidon: <http://archaeonatural.cloud/poseidon/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sf: <http://www.opengis.net/ont/sf#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix wikidata: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lado:DiscoverySite a owl:Class ;
    rdfs:label "LADO Discovery Site"@en ;
    rdfs:subClassOf lado:Location .

lado:ProductionCentre a owl:Class ;
    rdfs:label "LADO Production Centre"@en ;
    rdfs:subClassOf lado:KilnRegion .

lado:RepositoryLocation a owl:Class ;
    rdfs:label "LADO Repository Location"@en ;
    rdfs:subClassOf lado:Location .

lado:hasEntity a owl:ObjectProperty ;
    rdfs:label "has entity"@en ;
    rdfs:domain lado:Actor ;
    rdfs:range lado:ActorEntity .

lado:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location"@en ;
    rdfs:domain lado:Place ;
    rdfs:range lado:Location .

lado:interactsWith a owl:ObjectProperty ;
    rdfs:label "interacts with"@en ;
    rdfs:domain lado:ActorEntity ;
    rdfs:range lado:ActorEntity .

arno: a owl:Ontology ;
    rdfs:label "ArchaeoNatural Ontology (ArNO)"@en ;
    dc:contributor "Florian Thiery" ;
    dc:creator "Mattis thor Straten" ;
    dc:description "This ontology contains classes to describe Janno-files of the data of NFDI4Objects Task Area 3: currently Poseidon, soon ArboDat & Ossobook."@en ;
    dc:publisher "Mattis thor Straten" ;
    dc:rights "CC BY 4.0" ;
    dc:subject "archaeology; aDNA; archaeogenetics; archaeobotany; archaeozoology; spatiotemporal;"@en ;
    rdfs:comment "This ontology contains classes to describe the archaeo-natural data of NFDI4Objects Task Area 3: currently Poseidon, soon ArboDat & Ossobook."@en ;
    owl:versionInfo "0.2"@en .

arno:NoInformation a owl:Class ;
    rdfs:label "No Information About Entity"@en ;
    rdfs:comment """Entity type for blank nodes created for missing (Discovery Site) data values to indicate there is no information about this entity and no transitively reachable information
This is needed to ease obtaining such information using SPARQL queries as each entry has some geo information, it is just not entered."""@en ;
    rdfs:subClassOf crm:E1_CRM_Entity .

arno:UDGTreatment_mixed a owl:NamedIndividual ;
    rdfs:label "mixed"@en ;
    skos:prefLabel "mixed"@en .

arno:atPlace a owl:ObjectProperty ;
    rdfs:label "at place"@en ;
    rdfs:comment "place a site is located in"@en ;
    rdfs:domain arno:Site ;
    rdfs:range arno:Place ;
    rdfs:subPropertyOf owl:topObjectProperty .

arno:atSite a owl:ObjectProperty ;
    rdfs:label "at site"@en ;
    rdfs:comment "site a sample site is located in"@en ;
    rdfs:domain arno:DiscoverySite ;
    rdfs:range arno:Site ;
    rdfs:subPropertyOf crm:P89_falls_within .

arno:closeMatch a owl:ObjectProperty ;
    rdfs:label "close match"@en ;
    rdfs:comment "Matches nodes in the created namespace to nodes from other terminologies"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing ;
    rdfs:subPropertyOf skos:closeMatch .

arno:datedBy a owl:ObjectProperty ;
    rdfs:label "dated by"@en ;
    rdfs:comment "relates a biological sample to the dating event resulting from its dating process"@en ;
    rdfs:domain arno:BiologicalSample ;
    rdfs:range arno:Dating .

arno:foundAtDiscoverySite a owl:ObjectProperty ;
    rdfs:label "found at disovery site"@en ;
    rdfs:comment "discovery site where a sample was found"@en ;
    rdfs:domain arno:Sample ;
    rdfs:range arno:DiscoverySite ;
    rdfs:subPropertyOf crm:P53_has_former_or_current_location .

arno:fromGeneticSourceAccession a owl:ObjectProperty ;
    rdfs:label "from genetic source accession"@en ;
    rdfs:comment "links a sample with the source data used to generate its genotyping data"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range arno:GeneticSourceAccession ;
    rdfs:subPropertyOf crm:P2_has_type .

arno:hasAlternativeID a owl:DatatypeProperty ;
    rdfs:label "has alternative ID"@en ;
    rdfs:comment "alternative identifiers of an object, e.g., in other systems"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf arno:identifiedBy .

arno:hasCaptureType a owl:ObjectProperty ;
    rdfs:label "has capture type"@en ;
    rdfs:comment "capture type associated with an aDNA sample"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range arno:CaptureType ;
    rdfs:subPropertyOf crm:P2_has_type .

arno:hasCollectionID a owl:DatatypeProperty ;
    rdfs:label "has collection ID"@en ;
    rdfs:comment "alternative  identifier shared by the provider/owner of the data (in the original collection)"@en ;
    rdfs:domain arno:Sample ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf arno:identifiedBy .

arno:hasContaminationError a owl:DatatypeProperty ;
    rdfs:label "has contamination error"@en ;
    rdfs:comment "(modern) contamination estimate error of the sample"@en ;
    rdfs:domain arno:Contamination ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf arno:hasError .

arno:hasDOI a owl:ObjectProperty ;
    rdfs:label "has DOI"@en ;
    rdfs:comment "the DOI allowing to identify a document"@en ;
    rdfs:domain arno:Literature ;
    rdfs:range owl:Thing .

arno:hasDatingError a owl:DatatypeProperty ;
    rdfs:label "has dating error"@en ;
    rdfs:comment "a dating error considering the Uncalibrated Dating"@en ;
    rdfs:domain arno:C14Dating ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf arno:C14DatingInformation,
        arno:hasError .

arno:hasDatingType a owl:ObjectProperty ;
    rdfs:label "has dating type"@en ;
    rdfs:comment "the dating type that a dating is of"@en ;
    rdfs:domain arno:Dating ;
    rdfs:range arno:DatingType ;
    rdfs:subPropertyOf arno:datingInformation,
        crm:P2_has_type .

arno:hasExternalIdentifier a owl:ObjectProperty ;
    rdfs:label "has external identifier"@en ;
    rdfs:comment "links a node to a resource in the LOD cloud"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Resource .

arno:hasExternalIdentifierType a owl:ObjectProperty ;
    rdfs:label "has external identifier type"@en ;
    rdfs:comment "links a resource in the LOD cloud to the domain it comes from"@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range arno:externalIdentifierType .

arno:hasGeneticSex a owl:ObjectProperty ;
    rdfs:label "has genetic sex"@en ;
    rdfs:comment "genetic sex of the person an biological sample is taken from"@en ;
    rdfs:domain arno:BiologicalSample ;
    rdfs:range arno:GeneticSex ;
    rdfs:subPropertyOf crm:P2_has_type .

arno:hasGenotypePloidy a owl:ObjectProperty ;
    rdfs:label "has genotype ploidy"@en ;
    rdfs:comment "genotype ploidy associated with an aDNA sample"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range arno:GenotypePloidy ;
    rdfs:subPropertyOf crm:P2_has_type .

arno:hasID a owl:DatatypeProperty ;
    rdfs:label "has ID"@en ;
    rdfs:comment "the ID (identifier) given to identify an object"@en ;
    rdfs:domain owl:Thing ;
    rdfs:subPropertyOf arno:identifiedBy .

arno:hasISOCode a owl:DatatypeProperty ;
    rdfs:label "has ISO code"@en ;
    rdfs:comment "the ISO 3166 code allowing to identify a country"@en ;
    rdfs:domain arno:Country ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf arno:identifiedBy .

arno:hasKeyword a owl:DatatypeProperty ;
    rdfs:label "has keyword"@en ;
    rdfs:comment "keyword  to specify an object"@en ;
    rdfs:domain crm:E20_Biological_Object ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

arno:hasLabNumber a owl:DatatypeProperty ;
    rdfs:label "has lab number"@en ;
    rdfs:comment "the lab number lab numbers of a measurement allowing to identify it and the applied processes"@en ;
    rdfs:domain arno:C14Dating ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf arno:C14DatingInformation .

arno:hasLibraryCount a owl:DatatypeProperty ;
    rdfs:label "has library count"@en ;
    rdfs:comment "relating the number of libraries produced for an aDNA sample to the respective sample"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf arno:sample_measurements .

arno:hasLibraryStrandedness a owl:ObjectProperty ;
    rdfs:label "has library strandedness"@en ;
    rdfs:comment "strandedness of the library of an aDNA sample"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range arno:LibraryStrandedness ;
    rdfs:subPropertyOf crm:P2_has_type .

arno:hasMedian a owl:ObjectProperty ;
    rdfs:label "has median"@en ;
    rdfs:comment "Median of a temporal entity."@en ;
    rdfs:domain time:TemporalEntity ;
    rdfs:range time:Instant ;
    rdfs:subPropertyOf owl:topObjectProperty .

arno:hasNote a owl:DatatypeProperty ;
    rdfs:label "has note"@en ;
    rdfs:comment "any additional information"@en ;
    rdfs:domain crm:E1_CRM_Entity ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf crm:P3_has_note .

arno:hasNumericValue a owl:DatatypeProperty ;
    rdfs:label "has numeric value"@en ;
    rdfs:comment "a numeric measured value"@en ;
    rdfs:domain crm:E16_Measurement ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf arno:hasValue .

arno:hasORCID a owl:ObjectProperty ;
    rdfs:label "has ORCID"@en ;
    rdfs:comment "the ORCID ID allowing to identify an author"@en ;
    rdfs:domain arno:Person ;
    rdfs:range owl:Thing .

arno:hasPrimaryContact a owl:ObjectProperty ;
    rdfs:label "has primary contact"@en ;
    rdfs:comment "relates an aDNA sample to the person responsible for it"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range arno:Person ;
    rdfs:subPropertyOf crm:P50_has_current_keeper .

arno:hasRelationshipDegree a owl:DatatypeProperty ;
    rdfs:label "has relationship degree"@en ;
    rdfs:comment "adds a textual relationship degree to each aDNA sample relation"@en ;
    rdfs:domain arno:aDNASampleRelation ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf arno:aDNASampleRelationshipProperties .

arno:hasRelationshipType a owl:DatatypeProperty ;
    rdfs:label "has relationship type"@en ;
    rdfs:comment "adds a textual relationship type to each aDNA sample relation"@en ;
    rdfs:domain arno:aDNASampleRelation ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf arno:aDNASampleRelationshipProperties .

arno:hasRepresentativePoint a owl:ObjectProperty ;
    rdfs:label "has representative point"@en ;
    rdfs:comment "connects a spatial object to its representative point, might be an averaged representation for higher-level concepts"@en ;
    rdfs:domain geosparql:Feature ;
    rdfs:range geosparql:Geometry ;
    rdfs:subPropertyOf lado:PlaceOfInterest .

arno:hasSNPCount a owl:DatatypeProperty ;
    rdfs:label "has SNP count"@en ;
    rdfs:comment "number of non-missing SNPs to an aDNA sample"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf arno:sample_measurements .

arno:hasSourceTissueType a owl:ObjectProperty ;
    rdfs:label "has source tissue type"@en ;
    rdfs:comment "relates a source tissue to the respective material type it is made of"@en ;
    rdfs:domain arno:SourceTissue ;
    rdfs:range arno:SourceTissueType ;
    rdfs:subPropertyOf crm:P2_has_type .

arno:hasTextualValue a owl:DatatypeProperty ;
    rdfs:label "has textual value"@en ;
    rdfs:comment "a textual measured value"@en ;
    rdfs:domain crm:E16_Measurement ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf arno:hasValue .

arno:hasTitle a owl:DatatypeProperty ;
    rdfs:label "has title"@en ;
    rdfs:comment "the title of a document"@en ;
    rdfs:domain arno:Literature ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf arno:hasLabel .

arno:hasUDGTreatment a owl:ObjectProperty ;
    rdfs:label "has UDG treatment"@en ;
    rdfs:comment "the UDG treatment associated with an aDNA sample"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range arno:UDGTreatment ;
    rdfs:subPropertyOf crm:P2_has_type .

arno:hasURL a owl:DatatypeProperty ;
    rdfs:label "has URL"@en ;
    rdfs:comment "the URL where the information can be found"@en ;
    rdfs:domain crm:E73_Information_Object ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf arno:hasLabel .

arno:hasUncalibratedDate a owl:DatatypeProperty ;
    rdfs:label "has uncalibrated date"@en ;
    rdfs:comment "an uncalibrated date in BP obtained by a dating process"@en ;
    rdfs:domain arno:C14Dating ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf arno:C14DatingInformation .

arno:hasVersion a owl:DatatypeProperty ;
    rdfs:label "has version"@en ;
    rdfs:comment "Denotes the version of a dataset (package version in Poseidon)"@en ;
    rdfs:domain arno:Dataset ;
    rdfs:range rdfs:Literal .

arno:inCountry a owl:ObjectProperty ;
    rdfs:label "in country"@en ;
    rdfs:comment "country a location is located in"@en ;
    rdfs:domain arno:Place ;
    rdfs:range arno:Country ;
    rdfs:subPropertyOf owl:topObjectProperty .

arno:inJournal a owl:ObjectProperty ;
    rdfs:label "in journal"@en ;
    rdfs:comment "links a literature publication event to the journal it is published in"@en ;
    rdfs:domain arno:Literature ;
    rdfs:range arno:Journal ;
    rdfs:subPropertyOf dct:isPartOf .

arno:measuredContamination a owl:ObjectProperty ;
    rdfs:label "measured contamination"@en ;
    rdfs:comment "measured contamination of a sample"@en ;
    rdfs:domain arno:Contamination ;
    rdfs:range arno:Sample ;
    rdfs:subPropertyOf crm:P39_measured .

arno:measuredDamage a owl:DatatypeProperty ;
    rdfs:label "measured damage"@en ;
    rdfs:comment "measured % damage on the 5' end for the main shotgun library for an aDNA sample"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf arno:sample_measurements .

arno:measuredEndogenousDNA a owl:DatatypeProperty ;
    rdfs:label "measured endogenous DNA"@en ;
    rdfs:comment "measured % endogenous DNA for an aDNA sample"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf arno:sample_measurements .

arno:measuredMTHaplogroup a owl:ObjectProperty ;
    rdfs:label "measured MT-haplogroup"@en ;
    rdfs:comment "the measured MT-haplogroup of an aDNA sample"@en ;
    rdfs:domain arno:MTHaplogroupMeasurement ;
    rdfs:range arno:aDNASample ;
    rdfs:subPropertyOf arno:measuredHaplogroup .

arno:measuredSNPCoverage a owl:DatatypeProperty ;
    rdfs:label "measured SNP coverage"@en ;
    rdfs:comment "measured average X-fold coverage across targeted SNP sites for an aDNA sample"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf arno:sample_measurements .

arno:measuredYHaplogroup a owl:ObjectProperty ;
    rdfs:label "measured Y-haplogroup"@en ;
    rdfs:comment "the measured Y-haplogroup of an aDNA sample"@en ;
    rdfs:domain arno:YHaplogroupMeasurement ;
    rdfs:range arno:aDNASample ;
    rdfs:subPropertyOf arno:measuredHaplogroup .

arno:observedTimePeriod a owl:ObjectProperty ;
    rdfs:label "observed time period"@en ;
    rdfs:comment "the time period observed by a dating process"@en ;
    rdfs:domain arno:Dating ;
    rdfs:range arno:TimePeriod ;
    rdfs:subPropertyOf arno:datingInformation,
        time:hasTime .

arno:ofSourceTissue a owl:ObjectProperty ;
    rdfs:label "of source tissue"@en ;
    rdfs:comment "the source tissue (material) that a biological sample is of"@en ;
    rdfs:domain arno:BiologicalSample ;
    rdfs:range arno:SourceTissue .

arno:partOfGeneticSourceAccession a owl:ObjectProperty ;
    rdfs:label "part of genetic source accession"@en ;
    rdfs:comment "links genetic source accessions in case multiples are given arranged by descending specificity (e.g. project id > sample id > sequencing run id)"@en ;
    rdfs:domain arno:GeneticSourceAccession ;
    rdfs:range arno:GeneticSourceAccession ;
    rdfs:subPropertyOf dct:isPartOf .

arno:partOfGenomicLibrary a owl:ObjectProperty ;
    rdfs:label "part of genomic library"@en ;
    rdfs:comment "relates an aDNA sample with the genomic library is it part of"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range arno:GenomicLibrary ;
    rdfs:subPropertyOf dct:isPartOf,
        crm:P46i_forms_part_of .

arno:partOfGroup a owl:ObjectProperty ;
    rdfs:label "part of group"@en ;
    rdfs:comment "relates a sample to its population/group"@en ;
    rdfs:domain arno:Sample ;
    rdfs:range arno:Group ;
    rdfs:subPropertyOf dct:isPartOf .

arno:preparedByPreparationPipeline a owl:ObjectProperty ;
    rdfs:label "prepared by preparation pipeline"@en ;
    rdfs:comment "realtes an aDNA sample with the computational pipeline used to create it"@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range arno:PreparationPipeline .

arno:publishedInYear a owl:ObjectProperty ;
    rdfs:label "published in year"@en ;
    rdfs:comment "Connects a publication to the year it was published"@en ;
    rdfs:domain arno:Literature ;
    rdfs:range time:Instant .

arno:publishedSample a owl:ObjectProperty ;
    rdfs:label "published sample"@en ;
    rdfs:comment "links a literature to samples that are published by it"@en ;
    rdfs:domain arno:Literature ;
    rdfs:range arno:Sample ;
    rdfs:subPropertyOf crm:P70_documents .

arno:relatedByaDNASample a owl:ObjectProperty ;
    rdfs:label "related by  aDNA sample"@en ;
    rdfs:comment "this property is used to finish the connection between two aDNA samples using the Reification Class aDNASampleRelation"@en ;
    rdfs:domain arno:aDNASampleRelation ;
    rdfs:range arno:aDNASample .

arno:relatesToaDNASample a owl:ObjectProperty ;
    rdfs:label "relates to aDNA sample"@en ;
    rdfs:comment """relates an aDNA sample to other samples that are related/identical to this sample
since the object property itself cannot be associated with attributes, a Reification Class "aDNASampleRelation" is used to store them"""@en ;
    rdfs:domain arno:aDNASample ;
    rdfs:range arno:aDNASampleRelation .

arno:usedContaminationMeasure a owl:ObjectProperty ;
    rdfs:label "used contamination measure"@en ;
    rdfs:comment "relates a contamination measurement event to the used contamination measure"@en ;
    rdfs:domain arno:Contamination ;
    rdfs:range arno:ContaminationMeasure ;
    rdfs:subPropertyOf owl:topObjectProperty .

arno:version a owl:AnnotationProperty ;
    rdfs:label "version number" .

arno:writtenBy a owl:ObjectProperty ;
    rdfs:label "written by"@en ;
    rdfs:comment "relates a literature to its author"@en ;
    rdfs:domain arno:Literature ;
    rdfs:range arno:Person ;
    rdfs:subPropertyOf dct:creator .

poseidon:Literature_0069ed9b-d6dc-5154-aabf-1507353ce0d5 a arno:Literature,
        bibo:Document,
        prov:Entity ;
    rdfs:label "Ancient Rome: A genetic crossroads of Europe and the Mediterranean"@en ;
    arno:hasDOI <http://doi.org/10.1126/science.aay6826> ;
    arno:hasTitle "Ancient Rome: A genetic crossroads of Europe and the Mediterranean"@en ;
    arno:inJournal poseidon:Journal_e76ee763-0226-5d00-8b2d-46a0df49d7ea ;
    arno:publishedInYear [ a time:Instant ;
            time:inXSDgYear "2019"^^xsd:gYear ] ;
