    skos:prefLabel "Geonames"@en .

<http://archaeonatural.cloud/ExternalIdentifier_Wikidata> a arno:externalIdentifierType,
        owl:NamedIndividual ;
    rdfs:label "Wikidata"@en ;
    skos:prefLabel "Wikidata" .

arno:ContaminationMeasure a owl:Class ;
    rdfs:label "Contamination Measure"@en ;
    rdfs:comment "method to measure contamination, should be a software tool (ANGSD, Schmutzi, ...) and the respective software versions"@en ;
    rdfs:subClassOf crmdig:D10_Software_Execution .

arno:GeneticSex a owl:Class ;
    rdfs:label "Genetic Sex"@en ;
    rdfs:comment "genetic sex of the individual derived from this sample, only F, M or U because the EIGENSTRAT and PLINK formats only support these three, edge cases (e.g. XXY, XYY, X0) are undefined and should be grouped as F, M or U, with a Note added"@en ;
    rdfs:subClassOf obo:GSSO_000114 ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( arno:GeneticSex_Female arno:GeneticSex_Male arno:GeneticSex_Unknown ) ] .

arno:GeneticSex_Female a owl:NamedIndividual ;
    rdfs:label "Female"@en ;
    owl:sameAs <http://schema.org/Female> ;
    skos:prefLabel "Female"@en .

arno:GeneticSex_Unknown a owl:NamedIndividual ;
    rdfs:label "Unknown"@en ;
    skos:prefLabel "Unknown"@en .

arno:GenomicLibrary a owl:Class ;
    rdfs:label "Genomic Library"@en ;
    rdfs:comment "Genomic library used to generate the genotype data for the sample"@en ;
    rdfs:subClassOf crm:E18_Physical_Thing .

arno:GenotypePloidy a owl:Class ;
    rdfs:label "Genotype Ploidy"@en ;
    rdfs:comment "ploidy of the genotypes for the sample"@en ;
    rdfs:subClassOf obo:PATO_0001374,
        skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( arno:GenotypePloidy_diploid arno:GenotypePloidy_haploid ) ] .

arno:LibraryStrandedness a owl:Class ;
    rdfs:label "Library Strandedness"@en ;
    rdfs:comment "strandedness of the libraries, \"mixed\" in case multiple libraries with different protocols were merged"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( arno:LibraryStrandedness_ds arno:LibraryStrandedness_mixed arno:LibraryStrandedness_other arno:LibraryStrandedness_ss ) ] .

arno:LibraryStrandedness_ds a owl:NamedIndividual ;
    rdfs:label "ds"@en ;
    skos:prefLabel "ds"@en .

arno:LibraryStrandedness_other a owl:NamedIndividual ;
    rdfs:label "other"@en ;
    skos:prefLabel "other"@en .

arno:LibraryStrandedness_ss a owl:NamedIndividual ;
    rdfs:label "ss"@en ;
    skos:prefLabel "ss"@en .

arno:MTHaplogroupMeasurement a owl:Class ;
    rdfs:label "MT-Haplogroup Measurement"@en ;
    rdfs:comment "Measurement of the mitochondrial haplogroup derived for the sample as specified on phylotree.org and as reported by the Haplofind or Haplogrep software tools"@en ;
    rdfs:subClassOf arno:HaplogroupMeasurement .

arno:PreparationPipeline a owl:Class ;
    rdfs:label "Preparation Pipeline"@en ;
    rdfs:comment "computational pipeline used to generate the genotype data from the source data"@en ;
    rdfs:subClassOf crm:E29_Design_or_Procedure .

arno:SourceTissueType a owl:Class ;
    rdfs:label "Source Tissue Type"@en ;
    rdfs:comment "type of material sampled"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( arno:SourceTissueType_Hair arno:SourceTissueType_Petrous arno:SourceTissueType_Tooth arno:SourceTissueType_otherBone ) ] .

arno:SourceTissueType_Petrous a owl:NamedIndividual ;
    rdfs:label "Petrous"@en ;
    skos:prefLabel "Petrous"@en .

arno:SourceTissueType_Tooth a owl:NamedIndividual ;
    rdfs:label "Tooth"@en ;
    skos:prefLabel "Tooth"@en .

arno:SourceTissueType_otherBone a owl:NamedIndividual ;
    rdfs:label "other bone"@en ;
    skos:prefLabel "other bone"@en .

arno:UDGTreatment a owl:Class ;
    rdfs:label "UDG Treatment"@en ;
    rdfs:comment "udg treatment for the libraries, mixed in case multiple libraries with different UDG treatment were merged"@en ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass [ a owl:Class ;
