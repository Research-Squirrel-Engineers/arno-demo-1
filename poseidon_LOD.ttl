lado:ActorEntity a owl:Class ;
    rdfs:label "LADO Actor Entity"@en ;
    rdfs:subClassOf lado:Actor .

lado:Place a owl:Class ;
    rdfs:label "LADO Place as a Concept"@en ;
    dc:description "place as a concept, just a label"@en ;
    rdfs:subClassOf pleiades:Place .

arno:C14DatingInformation a owl:DatatypeProperty ;
    rdfs:label "c14 dating information"@en ;
    rdfs:comment "information related to a C14 dating"@en ;
    rdfs:domain arno:C14Dating ;
    rdfs:range rdfs:Literal .

arno:Contamination a owl:Class ;
    rdfs:label "Contamination"@en ;
    rdfs:comment "(modern) contamination of the sample as measured by the contamination measure"@en ;
    rdfs:subClassOf obo:PATO_0015031,
        crm:E16_Measurement .

arno:DatingType a owl:Class ;
    rdfs:label "Dating Type"@en ;
    rdfs:comment "type of dating information available for the sample, C14 if there is a set of radiocarbon dates whose post-calibration probability distribution is a meaningful prior for the individual's year of death, contextual for any other age information only given in modern for present-day individuals"@en ;
    rdfs:subClassOf skos:Concept .

arno:GenotypePloidy_haploid a owl:NamedIndividual ;
    rdfs:label "haploid"@en ;
    skos:prefLabel "haploid"@en .

arno:HaplogroupMeasurement a owl:Class ;
    rdfs:label "Haplogroup Measurement"@en ;
    rdfs:comment "Measurement of haplogroup information"@en ;
    rdfs:subClassOf crm:E16_Measurement .

arno:SourceTissue a owl:Class ;
    rdfs:label "Source Tissue"@en ;
    rdfs:comment "skeletal element, tissue or other material sampled, the specific bone should be reported after an underscore (e.g. bone_phalanx)"@en ;
    rdfs:subClassOf obo:UBERON_0000479 .

arno:TimePeriod a owl:Class ;
    rdfs:label "Time Period"@en ;
    rdfs:comment "Period of time defined by a starting and ending year in BC/AD"@en ;
    rdfs:subClassOf crm:E52_Time-Span,
        time:Interval .

arno:YHaplogroupMeasurement a owl:Class ;
    rdfs:label "Y-Haplogroup Measurement"@en ;
    rdfs:comment "Measurement of the Y-chromosome haplogroup derived for the sample following a syntax with the main branch + the most terminal derived Y-SNP (e.g. R1b-P312)"@en ;
    rdfs:subClassOf arno:HaplogroupMeasurement .

arno:externalIdentifierType a owl:Class ;
