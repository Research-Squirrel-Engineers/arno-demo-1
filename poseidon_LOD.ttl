geosparql:Geometry a owl:Class ;
    rdfs:label "GeoSPARQL Geometry"@en ;
    rdfs:comment "A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS)."@en ;
    rdfs:subClassOf geosparql:SpatialObject .

geosparql:SpatialObject a owl:Class ;
    rdfs:label "GeoSPARQL Spatial Object"@en ;
    rdfs:comment "Anything spatial (being or having a shape, position or an extent)."@en ;
    rdfs:subClassOf crm:E53_Place .

arno:C14Dating a owl:Class ;
    rdfs:label "C14 Dating"@en ;
    rdfs:comment "Radiocarbon (C14) dating is a method for determining the age of an object containing organic material by using the properties of radiocarbon, a radioactive isotope of carbon."@en ;
    rdfs:subClassOf arno:Dating .

